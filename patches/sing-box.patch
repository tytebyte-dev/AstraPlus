+                ) { fileHandle, name, inet6Active, handle, error in
+                    if let fileHandle, let name, let handle {
+                        reply(BridgeServiceHandshake(
+                            fileHandle: fileHandle,
+                            name: name as String,
+                            inet6Active: inet6Active,
