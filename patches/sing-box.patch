+                            DropdownMenuItem(
+                                text = { Text(stringResource(R.string.edit)) },
+                                leadingIcon = {
+                                    Icon(Icons.Outlined.Edit, contentDescription = null)
+                                },
+                                onClick = {
+                                    showMenu = false
+                                    navController.navigate(
+                                        "settings/remote_control/edit/${server.id}",
