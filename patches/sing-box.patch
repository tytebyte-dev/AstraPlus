+                    .first(where: { $0.identifier.rawValue == AppConfiguration.fileProviderDomainID }),
+                    let manager = NSFileProviderManager(for: domain)
+                else {
+                    return
+                }
+                try? await manager.signalEnumerator(for: .workingSet)
+            }
+        }
+    #endif
