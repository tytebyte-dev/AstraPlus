+            val discriminator = if (matched.isEmpty()) detectDiscriminator(leaves, depth + 1) else null
+            when {
+                matched.isNotEmpty() -> {
+                    for (variant in matched) {
+                        collectKeys(variant, siblingValues, result, depth + 1)
