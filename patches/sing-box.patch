+			Servers: []option.DNSServerOptions{
+				{Type: testDNSType, Tag: "one", Options: &balancerTestOptions{Name: "one"}},
+				{Type: testDNSType, Tag: "two", Options: &balancerTestOptions{Name: "two"}},
+			},
