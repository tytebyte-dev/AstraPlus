+	ctx = session.Context(ctx)
+	return ctx, &quicProxyResponseWriter{
+		writer:     h.listener.PacketWriter(),
+		clientAddr: source,
+	}
+}
+
+type quicProxyResponseWriter struct {
+	writer     N.PacketWriter
+	clientAddr M.Socksaddr
