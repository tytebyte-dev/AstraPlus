+                    }
+                    if (tunnelInfo.ipv4.isNotEmpty()) {
+                        TunnelInfoRow(tunnelInfo.ipv4.joinToString(", "), stringResource(R.string.endpoint_ipv4))
+                    }
+                    if (tunnelInfo.ipv6.isNotEmpty()) {
