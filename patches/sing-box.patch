+		HeaderProtectionKey:    base64.StdEncoding.EncodeToString(headerKeyBytes),
+		ContentPaddingAddition: "10-20",
+		RekeyAfterTime:         "100-120",
+		RekeyTimeout:           "5",
+		RejectAfterTime:        "180",
+		KeepaliveTimeout:       "10-15",
