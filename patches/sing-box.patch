+	listenDests []M.Socksaddr
+	remoteAddr  net.Addr
+	lastConn    *fakeConn
+}
+
+type blockingDialer struct {
+	called chan struct{}
+	once   sync.Once
+}
+
+type reconnectDialer struct {
+	dialCount int
+}
+
+type contextDialer struct {
+	conn    net.Conn
