+			changed:  true,
+			wantHost: "www.gstatic.com",
+		},
+		{
+			name:   "fake ip host preserves explicit port",
+			rawURL: "https://198.18.0.94:8443/path",
+			metadata: adapter.InboundContext{
+				FakeIP:            true,
+				Domain:            "example.com",
