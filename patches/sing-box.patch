+}
+
+func TestV5LazyPacketConnWriteDeadlineBeforeInit(t *testing.T) {
+	packetConn := newV5LazyPacketConn(context.Background(), nil, M.Socksaddr{}, M.Socksaddr{}, false)
+	t.Cleanup(func() { packetConn.Close() })
