+                return url.host != nil
+            case "data":
+                return true
+            default:
+                return false
+            }
+        }
+
+        private static func isAllowedNavigationURL(_ url: URL) -> Bool {
+            switch url.scheme?.lowercased() {
+            case "http", "https":
+                return url.host != nil
+            case "data", "about", "blob":
+                return true
+            default:
+                return false
+            }
+        }
