+private fun calculateDirSize(dir: File?): Long {
+    if (dir == null || !dir.exists()) return 0
+    var size = 0L
+    dir.listFiles()?.forEach { file ->
+        size += if (file.isDirectory) calculateDirSize(file) else file.length()
+    }
+    return size
+}
