+            when (currentServiceStatus) {
+                Status.Stopped -> {
+                    startService()
+                    return
+                }
+
+                Status.Starting -> {
+                    return
+                }
+
+                Status.Started, Status.Stopping -> {
+                    delay(100L)
+                }
+            }
+        }
+    }
