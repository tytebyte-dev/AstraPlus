+    onHideOfflineAppsToggle: () -> Unit,
+    onHideDisabledAppsToggle: () -> Unit,
+    onSelectAll: () -> Unit,
+    onDeselectAll: () -> Unit,
+    onImport: () -> Unit,
+    onExport: () -> Unit,
+) {
