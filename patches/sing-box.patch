+                            )
+                        }
+                        TaildropTransferItem(
+                            name = file.name,
+                            peerLabel = if (file.senderName.isEmpty()) {
+                                ""
+                            } else {
+                                stringResource(R.string.taildrop_from, file.senderName)
+                            },
+                            transferredBytes = file.receivedBytes,
+                            totalBytes = file.size,
