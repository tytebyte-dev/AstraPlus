diff --git a/clients/apple/ApplicationLibrary/Views/Abstract/NavigationStackCompat.swift b/clients/apple/ApplicationLibrary/Views/Abstract/NavigationStackCompat.swift
new file mode 100644
index 0000000000000000000000000000000000000000..f2dc3f192129d6ed0a108d4ac5be94ef3f92e9ff
--- /dev/null
