+		xmuxManager:     xmuxManager,
+	}
+	client.getHTTPClient = func() (DialerClient, *XmuxClient, error) {
+		xmuxClient := xmuxManager.GetXmuxClient(t.Context())
+		if firstXmux == nil {
+			firstXmux = xmuxClient
