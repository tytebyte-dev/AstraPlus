+        )
+        commandClient?.connect()
+    }
+
+    fun disconnect() {
+        commandClient?.disconnect()
+        commandClient = null
+    }
+
+    override fun updateOutbounds(outbounds: List<io.nekohasekai.libbox.OutboundGroupItem>) {
+        _outbounds.value = outbounds.map { GroupItem(it) }
