+    private fun detectDiscriminator(leaves: List<JsonObject>, depth: Int): String? {
+        if (leaves.isEmpty()) return null
+        return discriminatorNames.firstOrNull { name ->
+            leaves.all { leaf -> discriminatorSchema(leaf, name, depth) != null }
