+	called  chan struct{}
+	release chan struct{}
+}
+
+func (d *latePacketDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	close(d.called)
+	<-d.release
+	return d.conn, nil
+}
