+	}
+}
+
+func TestV2RayXHTTPOptionsLenientClientValues(t *testing.T) {
+	var options V2RayXHTTPOptions
+	if err := json.Unmarshal([]byte(`{
+		"sc_max_buffered_posts": 999999,
