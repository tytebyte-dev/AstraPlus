+			var options V2RayXHTTPOptions
+			if err := json.Unmarshal([]byte(content), &options); err == nil {
+				t.Fatal("expected error")
+			}
+		})
+	}
+}
+
+func TestV2RayXHTTPOptionsSupportsAutoUplinkDataPlacement(t *testing.T) {
