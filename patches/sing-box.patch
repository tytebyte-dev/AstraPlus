+ var obfBuilders = map[string]obfBuilder{
+ 	"b":  newBytesObf,
+ 	"t":  newTimestampObf,
++	"c":  newCounterObf,
+ 	"r":  newRandObf,
+ 	"rc": newRandCharObf,
+ 	"rd": newRandDigitsObf,
+@@ -96,10 +97,23 @@ func newObfChain(spec string) (*obfChain, error) {
+ }
