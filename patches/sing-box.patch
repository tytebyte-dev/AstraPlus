+fn request_method_name(method: u8) -> &'static str {
+    match method {
+        0 => "",
+        1 => "connect",
+        2 => "delete",
+        3 => "get",
+        4 => "head",
+        5 => "options",
+        6 => "patch",
+        7 => "post",
+        8 => "put",
+        _ => "other",
+    }
+}
