+type errorAfterReadCloser struct {
+	content []byte
+	err     error
+	read    bool
+}
+
+func (r *errorAfterReadCloser) Read(p []byte) (int, error) {
+	if r.read {
+		return 0, r.err
+	}
+	r.read = true
+	return copy(p, r.content), nil
+}
+
+func (r *errorAfterReadCloser) Close() error {
+	return nil
+}
