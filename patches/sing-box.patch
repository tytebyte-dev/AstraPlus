+		Servers: []option.DNSServerOptions{
+			{Type: testDNSType, Tag: "first", Options: &balancerTestOptions{Name: "first"}},
+			{Type: testDNSType, Tag: "second", Options: &balancerTestOptions{Name: "second"}},
