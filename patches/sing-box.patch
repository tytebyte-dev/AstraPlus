+				if body != nil {
+					go func() {
+						_, _ = io.Copy(io.Discard, body)
+						close(uploadBodyDone)
+					}()
+					if uploadOnly {
+						return io.NopCloser(strings.NewReader("")), &net.TCPAddr{}, &net.TCPAddr{}, nil
+					}
