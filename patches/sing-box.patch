+func TestClientBindKeepsSuccessfulDialContextAlive(t *testing.T) {
+	clientConn, serverConn := net.Pipe()
+	t.Cleanup(func() {
+		_ = clientConn.Close()
+		_ = serverConn.Close()
+	})
+	dialer := &contextStreamDialer{
+		conn:       clientConn,
+		dialCalled: make(chan struct{}),
+	}
+	bind := NewClientBind(
+		t.Context(),
+		logger.NOP(),
+		dialer,
+		true,
+		netip.MustParseAddrPort("192.0.2.1:51820"),
