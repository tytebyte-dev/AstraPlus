+func TestValidateObfuscationOptionsAcceptsRecommendedValues(t *testing.T) {
+	err := validateObfuscationOptions(option.AwgEndpointOptions{
+		Jc:   12,
+		Jmin: 50,
+		Jmax: 1000,
+		S1:   64,
+		S2:   64,
+		S3:   64,
+		S4:   64,
+	})
+	if err != nil {
+		t.Fatal(err)
