+	ctx := vision.WithHook(t.Context(), func(net.Conn) {
+		hookCalls.Add(1)
+	})
+
+	readCloser, remoteAddr, localAddr, err := client.OpenStream(ctx, "https://example.com/download", "session", nil, false)
+	if !errors.Is(err, requestErr) {
