diff --git a/clients/apple/ApplicationLibrary/Views/Abstract/ShareButton.swift b/clients/apple/ApplicationLibrary/Views/Abstract/ShareButton.swift
new file mode 100644
index 0000000000000000000000000000000000000000..58063659b4b6925280351ce86e9773337e3771cf
