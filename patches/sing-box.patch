+		baseRequestURL2: url.URL{Scheme: "https", Host: "example.com", Path: "/xhttp"},
+		getHTTPClient: func() (DialerClient, *XmuxClient, error) {
+			return dialerClient, xmux, nil
+		},
+		getHTTPClient2: func() (DialerClient, *XmuxClient, error) {
+			return dialerClient, xmux, nil
+		},
