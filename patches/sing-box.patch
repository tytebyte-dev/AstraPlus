diff --git a/clients/android/app/src/main/java/io/nekohasekai/sfa/database/preference/KeyValueEntity.kt b/clients/android/app/src/main/java/io/nekohasekai/sfa/database/preference/KeyValueEntity.kt
new file mode 100644
index 0000000000000000000000000000000000000000..29c0500ffbcfe603d856ac79570be8c9cafe1419
