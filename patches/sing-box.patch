+			}
+		default:
+			done = true
+		}
+	}
+	if err := conn.Close(); err != nil {
+		t.Fatal(err)
+	}
+	eventually(t, time.Second, func() bool {
+		return xmux.GetOpenUsage() == 0
+	}, "download xmux usage was not released")
+}
